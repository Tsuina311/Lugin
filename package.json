{
  "name": "lugin",
  "private": true,
  "version": "1.0.0",
  "description": "Chrome extension that captures a site's HTTP calls and renders a custom React UI overlay.",
  "type": "module",
  "packageManager": "yarn@3.8.1",
  "workspaces": [
    "mobile"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "goldfish:deploy": "wrangler deploy",
    "goldfish:proxy": "wrangler dev",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bump:minor": "node scripts/bump.mjs minor",
    "bump:major": "node scripts/bump.mjs major",
    "key": "node scripts/make-key.mjs",
    "package": "yarn build && node scripts/package.mjs",
    "package:testers": "yarn build && node scripts/package.mjs --testers",
    "test": "yarn test:import && yarn test:prices && yarn test:scan && yarn test:corpus && yarn test:sync && yarn test:web",
    "test:import": "node scripts/import-test.mjs",
    "test:prices": "node scripts/prices-test.mjs",
    "test:scan": "node scripts/scan-test.mjs",
    "test:corpus": "node scripts/corpus-test.mjs",
    "scan:calibrate": "node scripts/scan-eval.mjs --calibrate",
    "scan:eval": "node scripts/scan-eval.mjs",
    "scan:fixtures": "node scripts/scan-eval.mjs --build-fixtures",
    "scan:folds": "node scripts/scan-eval.mjs --folds",
    "scan:index": "node scripts/build-card-index.mjs --out .scan-fixtures/card-names.json",
    "scan:art-index": "node scripts/build-art-index.mjs --out .scan-fixtures/art-index.json",
    "scan:art-index:fixtures": "node scripts/build-art-index.mjs --from-fixtures --out .scan-fixtures/art-index.json",
    "scan:pipeline": "node scripts/scan-pipeline-eval.mjs",
    "scan:pipeline:real": "node scripts/scan-pipeline-eval.mjs --real",
    "scan:detect-eval": "node scripts/scan-detect-eval.mjs",
    "scan:detect-annotate": "node scripts/scan-detect-annotate.mjs",
    "scan:corpus:import": "node scripts/scan-corpus-import.mjs",
    "scan:variants": "node scripts/scan-eval.mjs --variants",
    "test:sync": "node scripts/sync-test.mjs",
    "test:web": "vite build --config vite.web.config.ts --ssr smoke.tsx --outDir ../dist-smoke --emptyOutDir && node dist-smoke/smoke.js",
    "stylelint": "stylelint \"src/**/*.{css,tsx}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,tsx}\" --fix",
    "eas-build-pre-install": "node ./scripts/eas-build-pre-install.mjs",
    "mobile:start": "yarn workspace lugin-mobile start",
    "mobile:android": "yarn workspace lugin-mobile android",
    "mobile:ios": "yarn workspace lugin-mobile ios",
    "mobile:prebuild": "yarn workspace lugin-mobile prebuild",
    "mobile:typecheck": "yarn workspace lugin-mobile typecheck",
    "mobile:test": "yarn workspace lugin-mobile test",
    "mobile:build:dev": "yarn workspace lugin-mobile build:dev",
    "mobile:fingerprint": "node scripts/mobile-eas.mjs fingerprint",
    "mobile:deploy:status": "node scripts/mobile-eas.mjs status",
    "mobile:update:status": "node scripts/mobile-eas.mjs status",
    "mobile:update": "yarn workspace lugin-mobile update:development",
    "mobile:build:eas": "yarn workspace lugin-mobile build:eas",
    "mobile:eas": "yarn workspace lugin-mobile eas"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@stylistic/eslint-plugin-jsx": "^4.4.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-storybook": "^0.11",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "postcss-styled-syntax": "^0.7.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^4.124.0"
  }
}
