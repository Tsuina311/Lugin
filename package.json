{
  "name": "lugin",
  "private": true,
  "version": "1.0.0",
  "description": "Chrome extension that captures a site's HTTP calls and renders a custom React UI overlay.",
  "type": "module",
  "packageManager": "yarn@3.8.1",
  "workspaces": [
    "mobile",
    "mobile/modules/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "goldfish:deploy": "wrangler deploy",
    "goldfish:proxy": "wrangler dev",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bump:minor": "node scripts/bump.mjs minor",
    "bump:major": "node scripts/bump.mjs major",
    "key": "node scripts/make-key.mjs",
    "package": "yarn build && node scripts/package.mjs",
    "package:testers": "yarn build && node scripts/package.mjs --testers",
    "test": "yarn test:import && yarn test:prices && yarn test:scan && yarn test:scan-inbox && yarn test:corpus && yarn test:sync && yarn test:web",
    "test:import": "node scripts/import-test.mjs",
    "test:prices": "node scripts/prices-test.mjs",
    "test:scan": "node scripts/scan-test.mjs",
    "test:scan-inbox": "node scripts/scan-inbox-test.mjs",
    "scan:replay": "node scripts/scan-replay.mjs",
    "scan:regression": "node scripts/scan-replay.mjs --regression",
    "scan:device-replay": "node scripts/scan-device-replay.mjs",
    "scan:capture-report": "node scripts/scan-capture-report.mjs",
    "scan:focus-report": "node scripts/scan-focus-report.mjs",
    "scan:swap-report": "node scripts/scan-swap-report.mjs",
    "scan:deck-report": "node scripts/scan-deck-report.mjs",
    "scan:normal-report": "node scripts/scan-normal-report.mjs",
    "scan:normal-forensics": "node scripts/scan-normal-forensics.mjs",
    "scan:capture-policy-report": "node scripts/scan-capture-policy-report.mjs",
    "scan:inbox": "node scripts/scan-inbox-server.mjs",
    "scan:inbox:tunnel": "node scripts/scan-inbox-tunnel.mjs",
    "scan:inbox:tunnel:named": "SCAN_INBOX_NAMED_TUNNEL=1 node scripts/scan-inbox-tunnel.mjs",
    "scan:inbox:latest": "node scripts/scan-inbox-latest.mjs",
    "scan:inbox:clean": "node scripts/scan-inbox-clean.mjs",
    "test:corpus": "node scripts/corpus-test.mjs",
    "scan:calibrate": "node scripts/scan-eval.mjs --calibrate",
    "scan:eval": "node scripts/scan-eval.mjs",
    "scan:fixtures": "node scripts/scan-eval.mjs --build-fixtures",
    "scan:folds": "node scripts/scan-eval.mjs --folds",
    "scan:index": "node scripts/build-card-index.mjs --out .scan-fixtures/card-names.json",
    "scan:art-index": "node scripts/build-art-index.mjs --out .scan-fixtures/art-index.json",
    "scan:art-index:fixtures": "node scripts/build-art-index.mjs --from-fixtures --out .scan-fixtures/art-index.json",
    "scan:art-replay": "node scripts/scan-art-replay.mjs",
    "scan:art-coverage": "node scripts/scan-art-coverage.mjs",
    "scan:printing-index": "node scripts/build-printing-index.mjs --out .scan-fixtures/printing-index.json",
    "scan:type-index": "node scripts/build-type-index.mjs --out .scan-fixtures/type-index.json",
    "scan:scanner-manifest": "node scripts/build-scanner-manifest.mjs",
    "scan:footer-replay": "node scripts/scan-footer-replay.mjs",
    "scan:channel-bench": "node scripts/scan-channel-bench.mjs",
    "scan:pipeline": "node scripts/scan-pipeline-eval.mjs",
    "scan:pipeline:real": "node scripts/scan-pipeline-eval.mjs --real",
    "recognition:bakeoff": "node scripts/recognition/bakeoff.mjs",
    "recognition:visual-index": "node scripts/recognition/build-visual-index.mjs",
    "recognition:model-bakeoff": "node scripts/recognition/model-bakeoff.mjs",
    "recognition:phase-a3": "node scripts/recognition/phase-a3-bakeoff.mjs",
    "recognition:pack-visual": "node scripts/recognition/pack-visual-assets.mjs",
    "recognition:parity-assets": "node scripts/recognition/parity-assets.mjs",
    "scan:continuous-report": "node scripts/scan-continuous-report.mjs",
    "recognition:import-g800": "node scripts/recognition/import-gallery800.mjs",
    "scan:detect-eval": "node scripts/scan-detect-eval.mjs",
    "scan:detect-native-parity": "node scripts/scan-detect-native-parity.mjs",
    "scan:detect-annotate": "node scripts/scan-detect-annotate.mjs",
    "scan:corpus:import": "node scripts/scan-corpus-import.mjs",
    "geometry:inventory": "node scripts/geometry/inventory.mjs",
    "geometry:bootstrap": "node scripts/geometry/bootstrap.mjs",
    "geometry:split": "node scripts/geometry/split.mjs",
    "geometry:lab": "node scripts/geometry/lab.mjs",
    "geometry:queue": "node scripts/geometry/queue.mjs",
    "geometry:benchmark": "node scripts/geometry/benchmark.mjs",
    "geometry:parity": "node scripts/geometry/parity.mjs",
    "geometry:leaderboard": "node scripts/geometry/leaderboard.mjs",
    "geometry:tune": "node scripts/geometry/tune.mjs",
    "geometry:y-sensitivity": "node scripts/geometry/y-sensitivity.mjs",
    "geometry:synthetic": "node scripts/geometry/synthetic.mjs",
    "geometry:synthetic:replay": "node scripts/geometry/synthetic-replay.mjs",
    "geometry:synthetic:curves": "node scripts/geometry/synthetic-curves.mjs",
    "geometry:synthetic:compare": "node scripts/geometry/synthetic-compare.mjs",
    "geometry:candidates": "node scripts/geometry/candidates.mjs",
    "geometry:refine": "node scripts/geometry/refine.mjs",
    "geometry:multicard-ceiling": "node scripts/geometry/multicard-ceiling.mjs",
    "geometry:temporal": "node scripts/geometry/temporal.mjs",
    "geometry:binder-diagnose": "node scripts/geometry/binder-diagnose.mjs",
    "geometry:budget-frontier": "node scripts/geometry/budget-frontier.mjs",
    "geometry:binder-mode": "node scripts/geometry/binder-mode.mjs",
    "geometry:binder-real-report": "node scripts/geometry/binder-real-report.mjs",
    "binder:real-report": "node scripts/geometry/binder-real-report.mjs",
    "geometry:real-capture-report": "node scripts/geometry/real-capture-report.mjs",
    "geometry:physical-refine-report": "node scripts/geometry/physical-refine-report.mjs",
    "scan:variants": "node scripts/scan-eval.mjs --variants",
    "test:sync": "node scripts/sync-test.mjs",
    "test:web": "vite build --config vite.web.config.ts --ssr smoke.tsx --outDir ../dist-smoke --emptyOutDir && node dist-smoke/smoke.js",
    "stylelint": "stylelint \"src/**/*.{css,tsx}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,tsx}\" --fix",
    "eas-build-pre-install": "node ./scripts/eas-build-pre-install.mjs",
    "mobile:start": "yarn workspace lugin-mobile start",
    "mobile:android": "yarn workspace lugin-mobile android",
    "mobile:ios": "yarn workspace lugin-mobile ios",
    "mobile:prebuild": "yarn workspace lugin-mobile prebuild",
    "mobile:typecheck": "yarn workspace lugin-mobile typecheck",
    "mobile:test": "yarn workspace lugin-mobile test",
    "mobile:build:dev": "yarn workspace lugin-mobile build:dev",
    "mobile:fingerprint": "node scripts/mobile-eas.mjs fingerprint",
    "mobile:deploy:status": "node scripts/mobile-eas.mjs status",
    "mobile:update:status": "node scripts/mobile-eas.mjs status",
    "mobile:update": "yarn workspace lugin-mobile update:development",
    "mobile:build:eas": "yarn workspace lugin-mobile build:eas",
    "mobile:eas": "yarn workspace lugin-mobile eas"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@huggingface/jinja": "^0.2.2",
    "@stylistic/eslint-plugin-jsx": "^4.4.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xenova/transformers": "2.17.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-storybook": "^0.11",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "jpeg-js": "^0.4.4",
    "onnxruntime-common": "1.14.0",
    "onnxruntime-node": "1.14.0",
    "onnxruntime-web": "1.14.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "postcss-styled-syntax": "^0.7.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^4.124.0"
  }
}
