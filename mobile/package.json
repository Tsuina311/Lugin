{
  "name": "lugin-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/smoke.cjs",
    "build:dev": "expo prebuild && expo run:android",
    "build:eas": "eas build --platform android --profile development",
    "update:development": "eas update --channel development --platform android --environment development --non-interactive"
  },
  "dependencies": {
    "expo": "~57.0.19",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "^57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-vision-camera": "^5.2.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
