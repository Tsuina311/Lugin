{
  "name": "lugin-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "yarn@3.8.1+sha512.8cfec856814c797ccb480703ca5270824327fac5abce240835e2699e01732229fd22bbeb1bb87047a0069f7698be9b2e3d9a926e6046e851faa9908fdacdeacf",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/smoke.cjs && node ./scripts/shared-core-smoke.mjs && node ./scripts/frame-adapter-smoke.mjs && node ./scripts/png-preview-smoke.mjs && node ./scripts/camera-select-smoke.mjs && node ./scripts/analysis-geometry-smoke.mjs && node ./scripts/orientation-lifecycle-smoke.mjs && node ./scripts/hires-map-smoke.mjs && node ./scripts/overlay-ease-smoke.mjs && node ./scripts/index-validate-smoke.mjs && node ./scripts/repository-conformance-smoke.mjs",
    "build:dev": "expo prebuild && expo run:android",
    "build:eas": "node ../scripts/write-mobile-build-stamp.mjs && eas build --platform android --profile development",
    "update:development": "node ../scripts/write-mobile-build-stamp.mjs && node ../scripts/mobile-eas.mjs update",
    "eas-build-pre-install": "node ../scripts/eas-build-pre-install.mjs"
  },
  "dependencies": {
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "^57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^23.2.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
