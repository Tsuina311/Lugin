node_modules
dist
dist-web
dist-smoke
release
*.local
.DS_Store

# Local price snapshot used while Pages does not yet serve prices.json.
.lugin-prices/

# Scanner test corpus: Scryfall card art plus tesseract traineddata, both
# downloaded on demand from the committed manifest in scripts/fixtures. Card
# images are copyrighted and have no business in the repository.
.scan-fixtures/

# The extension's own signing key. Losing it changes the extension id, which
# turns every existing install into a stranger — keep a backup off the repo.
.extension-key.pem
.vite

*.tsbuildinfo

# Yarn (Berry, node-modules linker) — commit yarn.lock, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
