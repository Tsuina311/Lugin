node_modules
dist
dist-web
dist-smoke
release
*.local
.DS_Store

# Local price snapshot used while Pages does not yet serve prices.json.
.lugin-prices/

# Commander Spellbook combo index (`yarn combos:update`). The software repo is
# MIT; that was not verified as permission to redistribute the combo dataset,
# so the generated JSON stays local.
generated/commander-combos/*.json

# Scanner test corpus: Scryfall card art plus tesseract traineddata, both
# downloaded on demand from the committed manifest in scripts/fixtures. Card
# images are copyrighted and have no business in the repository.
.scan-fixtures/

# Real phone photos + corner annotations for detection eval.
# Copyrighted card imagery — never commit.
.scan-real/

# Downloaded development-capture corpus (private; never commit).
.scan-corpus/

# The extension's own signing key. Losing it changes the extension id, which
# turns every existing install into a stranger — keep a backup off the repo.
.extension-key.pem
.vite

*.tsbuildinfo

# Yarn (Berry, node-modules linker) — commit yarn.lock, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Expo / React Native (mobile workspace)
mobile/.expo/
mobile/android/
mobile/ios/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.eas-decide.json
.eas-yarn-bin/
*.jks
*.p8
*.p12
*.mobileprovision
.scan-cache/

# Local phone → Mac debug inbox (camera images + tokens never belong in git).
.scan-inbox/

# Geometry benchmark corpus + run snapshots (card imagery / local paths).
.geometry-corpus/
.geometry-benchmarks/

# Generated on-device visual index (pack via scripts/recognition/pack-visual-assets.mjs).
# Weights are large and rebuilt locally — never commit the binaries.
mobile/modules/lugin-visual-recognizer/**/assets/lugin-visual/*.onnx
mobile/modules/lugin-visual-recognizer/**/assets/lugin-visual/*.bin
mobile/modules/lugin-visual-recognizer/**/assets/lugin-visual/oracle-map.json
